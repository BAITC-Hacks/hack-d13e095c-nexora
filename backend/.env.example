# Получите read-токен на https://huggingface.co/settings/tokens после принятия
# условий модели pyannote/speaker-diarization-community-1.
HF_TOKEN=hf_replace_me

# При необходимости измените значения ниже.
POSTGRES_PASSWORD=meetings
API_PORT=8000
FRONTEND_PORT=5173
OLLAMA_MODEL=qwen3:8b
# IP компьютера, где уже запущена Ollama. Адрес должен быть локальным/private.
OLLAMA_URL=http://192.168.1.100:11434
WHISPER_MODEL=large-v3
AI_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
API_KEY=
