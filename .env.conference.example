# LAN IP of the computer running Docker. No scheme or port here.
SITE_HOST=192.168.1.100
HTTPS_PORT=8443
FRONTEND_PORT=5173
API_PORT=8000
POSTGRES_PASSWORD=meetings

# Ollama remains on your separate PC. Never use an external/cloud endpoint.
OLLAMA_URL=http://192.168.1.101:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
LIVE_ANALYSIS_INTERVAL=30

# Default: self-hosted speech service on this Docker host (--profile speech).
# For a separate ASR PC use http://192.168.1.101:8001 and omit --profile speech.
SPEECH_URL=http://speech:8001
SPEECH_API_KEY=
SPEECH_REPO=Systran/faster-whisper-large-v3
SPEECH_REVISION=main
AI_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Optional: require a secret to CREATE rooms. Invitees need only the invite link.
CONFERENCE_ACCESS_KEY=
# Protect legacy admin API (only exposed on host loopback).
API_KEY=
MEETING_TIMEZONE=Asia/Almaty
# No public STUN/TURN used. For routed networks provide a self-hosted TURN server.
RTC_ICE_SERVERS=[]

# Shared team memory: all meeting discussions are visible in the graph.
# Optional team key (if empty, CONFERENCE_ACCESS_KEY is used; both empty = LAN access).
MEMORY_ACCESS_KEY=
