{
  admin off
  # Chrome on Windows may omit SNI when it connects to a LAN IP. Without a
  # default name Caddy aborts the TLS handshake with ERR_SSL_PROTOCOL_ERROR.
  default_sni {$SITE_HOST:localhost}
}

(conference) {
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
  }
  handle /api/v1/conferences* {
    header Cache-Control no-store
    reverse_proxy api:8000
  }
  handle /api/* {
    respond "Not found" 404
  }
  handle {
    reverse_proxy frontend:5173
  }
}

https://{$SITE_HOST:localhost} {
  tls internal
  import conference
}

http://:8080 {
  import conference
}
